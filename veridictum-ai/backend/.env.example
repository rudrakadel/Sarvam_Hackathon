# VeriDictum AI — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME=VeriDictum AI
APP_ENV=development
DEBUG=false

# ── Security ───────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./veridictum.db
SYNC_DATABASE_URL=sqlite:///./veridictum.db

# ── Redis / Celery ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── CORS ───────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-nano-2025-04-14

# ── DeepInfra (Whisper v3 — audio transcription) ───────────────────────────────
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
WHISPER_MODEL=openai/whisper-large-v3

# ── Azure Document Intelligence ─────────────────────────────────────────────────
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your_azure_document_intelligence_key_here
AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DI_KEY=your_azure_document_intelligence_key_here

# ── Azure Blob Storage ─────────────────────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=your_azure_storage_connection_string_here
AZURE_STORAGE_CONTAINER_AUDIO=veridictum-audio
AZURE_STORAGE_CONTAINER_DOCUMENTS=veridictum-documents
AZURE_STORAGE_CONTAINER_REPORTS=veridictum-reports

# ── Pinecone (vector search) ────────────────────────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=veridictum-vectors

# ── Email (SMTP) ────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here
EMAIL_FROM=VeriDictum AI <noreply@veridictum.ai>

# ── MFA ────────────────────────────────────────────────────────────────────────
TOTP_ISSUER=VeriDictum AI

# ── File Size Limits ────────────────────────────────────────────────────────────
MAX_AUDIO_SIZE_BYTES=5368709120
MAX_DOCUMENT_SIZE_BYTES=524288000

# ── Access Token ───────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
